# API Key para el modelo de IA (Anthropic Claude)
# Obtén la tuya en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu-api-key-aqui

# Opcional: modelo a usar
# Opciones recomendadas:
#   - claude-sonnet-4-5-20250929 (default, mejor balance calidad/precio)
#   - claude-opus-4-5-20250929   (máxima calidad, más caro)
#   - claude-haiku-4-5-20251001  (más rápido y barato)
# AI_MODEL=claude-sonnet-4-5-20250929
