# API Key para el modelo de IA (Anthropic Claude)
# Obtén la tuya en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu-api-key-aqui

# Opcional: modelo a usar
# Opciones recomendadas (ordenadas de más potente a más económico):
#   - claude-opus-4-6            (máxima calidad, más caro)
#   - claude-sonnet-4-6          (default, mejor balance calidad/precio)
#   - claude-haiku-4-5-20251001  (más rápido y económico)
# AI_MODEL=claude-sonnet-4-6
